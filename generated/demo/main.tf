# Generated by SecureVibe OS - secure VPC (vpc_main)
data "aws_availability_zones" "available" {
  state = "available"
}

resource "aws_vpc" "vpc_main" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true
  tags = { Name = "vpc_main" }
}

# Lock down the default security group (CIS 5.4)
resource "aws_default_security_group" "vpc_main_default" {
  vpc_id = aws_vpc.vpc_main.id
}

resource "aws_subnet" "vpc_main_private" {
  count             = 2
  vpc_id            = aws_vpc.vpc_main.id
  cidr_block        = cidrsubnet("10.0.0.0/16", 8, count.index)
  availability_zone = data.aws_availability_zones.available.names[count.index]
  map_public_ip_on_launch = false
  tags = { Name = "vpc_main-private-${count.index}", Tier = "private" }
}

resource "aws_kms_key" "vpc_main_logs" {
  description         = "KMS key for vpc_main flow logs"
  enable_key_rotation = true
}

resource "aws_cloudwatch_log_group" "vpc_main_flow" {
  name              = "/vpc/vpc_main/flow-logs"
  retention_in_days = 365
  kms_key_id        = aws_kms_key.vpc_main_logs.arn
}

resource "aws_iam_role" "vpc_main_flow" {
  name = "vpc_main-flow-logs"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{ Effect = "Allow", Action = "sts:AssumeRole", Principal = { Service = "vpc-flow-logs.amazonaws.com" } }]
  })
}

resource "aws_iam_role_policy" "vpc_main_flow" {
  name = "vpc_main-flow-logs"
  role = aws_iam_role.vpc_main_flow.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"]
      Resource = "${aws_cloudwatch_log_group.vpc_main_flow.arn}:*"
    }]
  })
}

resource "aws_flow_log" "vpc_main" {
  vpc_id          = aws_vpc.vpc_main.id
  traffic_type    = "ALL"
  log_destination = aws_cloudwatch_log_group.vpc_main_flow.arn
  iam_role_arn    = aws_iam_role.vpc_main_flow.arn
}

resource "aws_kms_key" "s3_app" {
  description         = "KMS key for bucket s3_app"
  enable_key_rotation = true
}

resource "aws_s3_bucket" "s3_app" {
  bucket_prefix = "s3-app-"
  tags = { Name = "s3_app", DataClassification = "PII", ContainsPII = "true" }
}

resource "aws_s3_bucket_public_access_block" "s3_app" {
  bucket                  = aws_s3_bucket.s3_app.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "s3_app" {
  bucket = aws_s3_bucket.s3_app.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm     = "aws:kms"
      kms_master_key_id = aws_kms_key.s3_app.arn
    }
  }
}

resource "aws_s3_bucket_versioning" "s3_app" {
  bucket = aws_s3_bucket.s3_app.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_kms_key" "rds_main" {
  description         = "KMS key for RDS rds_main"
  enable_key_rotation = true
}

resource "aws_db_subnet_group" "rds_main" {
  name       = "rds-main"
  subnet_ids = aws_subnet.vpc_main_private[*].id
}

resource "aws_db_instance" "rds_main" {
  identifier                          = "rds-main"
  engine                              = "postgres"
  instance_class                      = "db.t3.medium"
  allocated_storage                   = 20
  db_name                             = "appdb"
  username                            = "dbadmin"
  manage_master_user_password         = true
  publicly_accessible                 = false
  storage_encrypted                   = true
  kms_key_id                          = aws_kms_key.rds_main.arn
  multi_az                            = true
  deletion_protection                 = true
  backup_retention_period             = 7
  iam_database_authentication_enabled = true
  auto_minor_version_upgrade          = true
  copy_tags_to_snapshot               = true
  enabled_cloudwatch_logs_exports     = ["postgresql"]
  db_subnet_group_name                = aws_db_subnet_group.rds_main.name
  skip_final_snapshot                 = false
  final_snapshot_identifier           = "rds-main-final"
}

data "aws_ami" "ec2_app" {
  most_recent = true
  owners      = ["amazon"]
  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }
}

resource "aws_instance" "ec2_app" {
  ami                         = data.aws_ami.ec2_app.id
  instance_type               = "t3.micro"
  subnet_id                   = aws_subnet.vpc_main_private[0].id
  associate_public_ip_address = false
  monitoring                  = true
  ebs_optimized               = true
  metadata_options {
    http_tokens   = "required"
    http_endpoint = "enabled"
  }
  root_block_device {
    encrypted = true
  }
  tags = { Name = "ec2_app" }
}
