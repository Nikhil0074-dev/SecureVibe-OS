resource "aws_kms_key" "{{ id }}" {
  description         = "KMS key for bucket {{ id }}"
  enable_key_rotation = true
}

resource "aws_s3_bucket" "{{ id }}" {
  bucket_prefix = "{{ id | replace('_', '-') }}-"
  tags = { Name = "{{ id }}", DataClassification = "{{ dataClassification }}", ContainsPII = "{{ 'true' if containsPii else 'false' }}" }
}

resource "aws_s3_bucket_public_access_block" "{{ id }}" {
  bucket                  = aws_s3_bucket.{{ id }}.id
  block_public_acls       = {{ 'true' if blockPublicAcls else 'false' }}
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "{{ id }}" {
  bucket = aws_s3_bucket.{{ id }}.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm     = "aws:kms"
      kms_master_key_id = aws_kms_key.{{ id }}.arn
    }
  }
}

resource "aws_s3_bucket_versioning" "{{ id }}" {
  bucket = aws_s3_bucket.{{ id }}.id
  versioning_configuration {
    status = "Enabled"
  }
}
